<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="16dp">

		<TextView
			android:id="@+id/sync_source_path"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

		<EditText
			android:id="@+id/sync_source_password"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:hint="@string/screen_sync_source_password"
			android:inputType="textPassword" />

		<TextView
			android:id="@+id/sync_target_path"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/screen_sync_target_not_chosen"
			android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

		<EditText
			android:id="@+id/sync_target_password"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:hint="@string/screen_sync_target_password"
			android:inputType="textPassword" />

		<RadioGroup
			android:id="@+id/sync_mode_group"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp">

			<RadioButton
				android:id="@+id/sync_mode_bidirectional"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:checked="true"
				android:text="@string/screen_file_browser_sync_mode_bidirectional" />

			<RadioButton
				android:id="@+id/sync_mode_local_to_target"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/screen_file_browser_sync_mode_local_to_target" />

			<RadioButton
				android:id="@+id/sync_mode_target_to_local"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/screen_file_browser_sync_mode_target_to_local" />

		</RadioGroup>

		<RadioGroup
			android:id="@+id/sync_conflict_group"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp">

			<RadioButton
				android:id="@+id/sync_conflict_option_1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:checked="true"
				android:text="@string/screen_sync_conflict_local_wins" />

			<RadioButton
				android:id="@+id/sync_conflict_option_2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/screen_sync_conflict_cloud_wins" />

			<RadioButton
				android:id="@+id/sync_conflict_option_3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/screen_sync_conflict_time" />

		</RadioGroup>

	</LinearLayout>

</ScrollView>
